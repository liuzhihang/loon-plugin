#!name=NodeSeek 自动签到
#!desc=单账号签到；在 Safari 手动签到后保存本地会话；支持固定或随机奖励，安全验证时停止
#!author=liuzhihang（独立实现与维护）
#!homepage=https://github.com/liuzhihang/loon-plugin
#!tag=Check-in
#!loon_version=3.5.1(983)
#!date=2026-10-20
# SPDX-License-Identifier: MIT

[Argument]
random = switch,false,type=boolean,tag=随机奖励,desc=关闭发送 random=false；开启发送 random=true；实际奖励以服务端为准
useCache = switch,true,type=boolean,tag=同日跳过,desc=按 UTC+8 的本地确认记录避免重复请求；关闭后每次运行均向服务端提交一次

[Script]
response if ${url} ~= /^https:\/\/www\.nodeseek\.com\/api\/attendance\?random=(?:true|false)$/ && ${request.method} == "POST" && ${response.status} == 200 then script("https://raw.githubusercontent.com/liuzhihang/loon-plugin/main/scripts/nodeseek/nodeseek.js") with requires_body=true, timeout=10, tag="NodeSeek抓包", enable=true
cron "30 9 * * *" then script("https://raw.githubusercontent.com/liuzhihang/loon-plugin/main/scripts/nodeseek/nodeseek.js", {${random}, ${useCache}}) with timeout=30, tag="NodeSeek签到", enable=true

[MITM]
hostname = www.nodeseek.com
