#!name=网鱼自动签到
#!desc=刷新 f1sh.com/checkin 保存会话；先查询今日状态，未签到才提交并复核
#!author=liuzhihang
#!homepage=https://github.com/liuzhihang/loon-plugin
#!tag=Check-in
#!loon_version=3.5.1(983)
#!date=2026-10-25
# SPDX-License-Identifier: MIT

[Argument]
capture = switch,true,type=boolean,tag=捕获登录会话,desc=登录网鱼后进入或刷新 /checkin 即可保存 Cookie 与 User-Agent，无需先签到；保存后可关闭
autoCheckin = switch,false,type=boolean,tag=自动签到,desc=保存会话后开启；关闭时同时阻止定时与手动执行签到入口
cronExpression = input,"35 9 * * *",type=string,tag=执行时间,desc=设备本地时间的 Cron 表达式；默认每天 09:35
mood = input,"nice",type=string,tag=签到心情,desc=nice好耶 happy哈哈哈 love比心 working摸鱼 sleepy困了 popcorn吃瓜 cry呜呜 angry气鼓鼓 hello冒个泡

[Script]
response if ${url} ~= /^https:\/\/f1sh\.com\/checkin(?:\?[^#]*)?$/ && ${request.method} == "GET" && ${response.status} == 200 then script("https://raw.githubusercontent.com/liuzhihang/loon-plugin/main/scripts/f1sh/f1sh.js", "capture") with requires_body=true, timeout=10, tag="网鱼会话捕获_自动触发", enable=${capture}
cron ${cronExpression} then script("https://raw.githubusercontent.com/liuzhihang/loon-plugin/main/scripts/f1sh/f1sh.js", {${autoCheckin}, ${mood}}) with timeout=40, tag="网鱼执行签到_会发请求", enable=${autoCheckin}

[MITM]
hostname = f1sh.com
